# Réglages de la maintenance automatique de wmail-go.
# Ce fichier est lu par « . » (sh) : toute valeur contenant une espace DOIT être entre guillemets,
# sinon le shell prend la suite pour une commande (« REMOTES=origin gitea » exécute « gitea »).
#
# Installation :
#   install -m 600 tools/maintenance/maj.env.exemple /data/Work/wmail-go/.maj.env
#   $EDITOR /data/Work/wmail-go/.maj.env
# Puis, dans le cron ou l'environnement : WMAIL_MAJ_CONF=/data/Work/wmail-go/.maj.env

# --- dépôts ---
CLE_SSH=/root/.ssh/id_wmail_go_maj
REMOTES="origin gitea"
BRANCHE=main

# --- courriel ---
DESTINATAIRE=wmail-go@degoulet.net
# EXPEDITEUR=wmail-go@teechix.degoulet.net
# sendmail ou msmtp :  MAILER="sendmail -t"   /   MAILER="msmtp -t"
# sans aucun des deux, l'envoi par curl fourni :
MAILER=/data/Work/wmail-go/tools/maintenance/envoi-smtp.sh
SMTP_URL=smtp://mail.degoulet.net:587
SMTP_USER=wmail-go@degoulet.net
SMTP_PASS="mot de passe"
# always | changes | failures | never
NOTIFIER=changes

# --- comportement ---
# jours de quarantaine avant d'adopter une version publiée
QUARANTAINE=5
# projet compose distinct du webmail en service
COMPOSE_PROJECT_NAME=wmail-go-ci
# commande compose, si « docker compose » n'existe pas
# COMPOSE=podman-compose
JOURNAL=/data/Work/logs/wmail-go.log
