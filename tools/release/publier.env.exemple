# Réglages de publication de l'image — à copier en publier.env, puis « chmod 600 publier.env ».
# Ce fichier contient un secret : il ne doit jamais être versionné (il est ignoré par .gitignore).
#
#   ./tools/release/publier-image.sh --env=tools/release/publier.env

IMAGE=docker.io/gdegoulet/wmail-go

# Identifiant Docker Hub et jeton d'accès personnel (Account settings → Personal access tokens),
# avec la permission « Read & Write ». N'utilisez pas votre mot de passe de compte.
REGISTRE_USER=gdegoulet
# Collez ici le jeton (il commence par « dckr_pat_ »). Laissé vide, le script compte sur un « docker login ».
REGISTRE_TOKEN=

# Étiquettes supplémentaires éventuelles, séparées par des espaces (« stable », « edge »…).
#ETIQUETTES_SUP="stable"

# Construction multi-architecture : exige « docker buildx » (absent avec Podman).
#PLATEFORMES=linux/amd64,linux/arm64

# Raccourcis utiles pour une publication automatique.
#SANS_TESTS=0
#TIRER=1
