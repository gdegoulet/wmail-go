# Mise en forme commune aux éditeurs. Le Go est formaté par gofmt (tabulations).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{js,css,html,json,yml,yaml,py,sh}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
